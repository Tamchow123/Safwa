# Safwa server environment (Phase 15). Copy to .env.local for local
# development; never commit .env.local. See docs/DEPLOYMENT.md §2.

# PostgreSQL connection string (postgres:// or postgresql://). Local docker
# compose default matches docker/init-test-db.sql + compose.yaml.
DATABASE_URL=postgres://safwa:safwa_dev_only@localhost:5432/safwa_dev

# Better Auth session/token signing secret. Generate with:
#   pnpm exec auth secret
# Required to be >=32 characters in production.
BETTER_AUTH_SECRET=

# Canonical origin Better Auth issues callback/verification links against.
BETTER_AUTH_URL=http://localhost:3000

# Public app origin (client bundles). Must match BETTER_AUTH_URL's origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service-worker kill switch (Phase 18). Left UNSET here on purpose: unset
# means "on in a production build, off otherwise", which is what keeps a worker
# out of `next dev` and out of the four Playwright configs that predate this
# phase. Set explicitly only to override that:
#   false — unregisters any installed worker and deletes its caches. This is
#           the rollback step in docs/DEPLOYMENT.md §8; a worker outlives a
#           deploy, so only a build that says `false` can undo one.
#   true  — registers even in a non-production build (the offline E2E config).
# NEXT_PUBLIC_SW_ENABLED=

# Auth feature flag / rollback kill-switch. false = auth routes report a safe
# "unavailable" state; guest study is unaffected either way.
AUTH_ENABLED=true

# Online-sync feature flag / rollback kill-switch (Phase 16). false = sync
# endpoints report a safe "unavailable" state and signed-in users continue
# local-only study; auth and guests are unaffected. Requires AUTH_ENABLED=true
# (in production, SYNC_ENABLED=true with AUTH_ENABLED=false is rejected).
SYNC_ENABLED=true

# console-file (default, local/dev/test — no external email sends) | resend
# (preview/production).
EMAIL_TRANSPORT=console-file

# Required when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
EMAIL_FROM=

# Directory the console-file transport writes messages to (gitignored).
EMAIL_OUTBOX_DIR=.local/email-outbox

# Directory containing the server-only content manifests
# (content-server/release-registry.json + releases/<id>/{validation,assessment,checksums}.json).
CONTENT_SERVER_DIR=content-server

# Escape hatch for preview deployments that build with NODE_ENV=production
# but intentionally still want the console/file transport. Leave unset
# everywhere else — real production must use resend.
ALLOW_DEV_EMAIL_TRANSPORT_IN_PRODUCTION=false

# Applied uniformly to every sensitive auth endpoint's rate-limit rule
# (sign-up/sign-in/send-verification-email/request-password-reset/
# reset-password/delete-user). Lower these in integration tests for a
# fast, deterministic trigger — never disable rate limiting outright.
# In PRODUCTION these are bounded (Phase 18): window 30-3600s, max 1-20.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=5

# The DEFAULT rate-limit bucket, applied to every endpoint NOT listed above
# (get-session, sign-out, list-sessions, ...). Read-mostly and hit on every
# page mount, so it is far more generous. Unset means Better Auth's own
# built-in default (10s/100), which is what production runs.
# In PRODUCTION these are bounded (Phase 18): window 5-3600s, max 1-1000.
AUTH_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=10
AUTH_RATE_LIMIT_DEFAULT_MAX=100

# Comma-separated addresses permitted to create an account (Phase 18).
# REQUIRED in production — an unset value there is refused at start-up, since
# for a personal instance open sign-up is the bug rather than the safeguard.
# Unset outside production keeps sign-up open, which local development and the
# test suites rely on. Matching is case-insensitive; aliases are NOT expanded,
# so list owner+tag@example.com explicitly if you use one.
SIGNUP_ALLOWED_EMAILS=
